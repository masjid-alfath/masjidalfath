{{ define "main" }}

<section
  class="
    relative
    overflow-hidden
    border-b border-white/[0.07]
    py-16
    lg:py-20
  "
>

  <!-- Ambient Aurora -->
  <div
    class="
      pointer-events-none
      absolute
      inset-0
      -z-10
      bg-[radial-gradient(circle_at_15%_15%,rgb(102_201_255/0.10),transparent_30%),radial-gradient(circle_at_80%_5%,rgb(162_138_229/0.09),transparent_28%)]
    "
    aria-hidden="true"
  ></div>


  <div class="container-site">

    <div
      class="
        grid
        gap-8
        lg:grid-cols-[1fr_0.7fr]
        lg:items-end
      "
    >

      <div>

        <p class="eyebrow text-aurora-violet">
          Aktivitas Al-Fath
        </p>

        <h1
          class="
            mt-4
            max-w-3xl
            text-4xl
            font-bold
            leading-[1.05]
            tracking-[-0.045em]
            sm:text-5xl
            lg:text-6xl
          "
        >
          Ruang untuk belajar,
          <span class="aurora-text">
            bertumbuh, dan berbagi.
          </span>
        </h1>

      </div>


      <div class="lg:pb-1">

        <p
          class="
            max-w-lg
            text-base
            leading-[1.8]
            text-muted
            lg:ml-auto
          "
        >
          Beragam program Masjid Al-Fath dihadirkan
          untuk menemani jamaah mendekat kepada
          Al-Qur'an, menuntut ilmu, serta menebarkan
          manfaat bersama.
        </p>

      </div>

    </div>

  </div>

</section>



<section class="py-16 lg:py-20">

  <div class="container-site">

    <div class="mx-auto max-w-5xl">

      {{ $pages := .Pages.ByParam "order" }}

      {{ $categories := slice
        (dict
          "name" "Kajian & Pendidikan"
          "id" "kajian-pendidikan"
          "description" "Ruang belajar dan pembinaan untuk bertumbuh bersama ilmu."
          "accent" "text-aurora-cyan"
          "line" "bg-aurora-cyan"
          "border" "hover:border-aurora-cyan/30"
        )
        (dict
          "name" "Layanan Jamaah"
          "id" "layanan-jamaah"
          "description" "Layanan yang hadir untuk mendampingi kebutuhan jamaah."
          "accent" "text-aurora-violet"
          "line" "bg-aurora-violet"
          "border" "hover:border-aurora-violet/30"
        )
        (dict
          "name" "Sosial & Sedekah"
          "id" "sosial-sedekah"
          "description" "Jalan berbagi manfaat melalui sedekah dan program sosial."
          "accent" "text-aurora-coral"
          "line" "bg-aurora-coral"
          "border" "hover:border-aurora-coral/30"
        )
      }}


      <!-- DIRECTORY HEADER -->

      <div
        class="
          mb-8
          flex
          items-center
          justify-between
          gap-6
        "
      >

        <p
          class="
            text-xs
            font-bold
            uppercase
            tracking-[0.16em]
            text-muted
          "
        >
          Program Aktif
        </p>

        <p class="text-sm text-muted">
          {{ len $pages }} program
        </p>

      </div>


      <!-- CATEGORY NAVIGATION -->

      <nav
        class="
          mb-14
          flex
          gap-2
          overflow-x-auto
          pb-2
          sm:flex-wrap
          sm:overflow-visible
          sm:pb-0
        "
        aria-label="Kategori program"
      >

        {{ range $categories }}

          {{ $categoryPages := where $pages "Params.category" .name }}

          {{ if gt (len $categoryPages) 0 }}

            <button
              type="button"
              class="
                program-category-filter
                inline-flex
                min-h-10
                shrink-0
                items-center
                gap-2
                rounded-full
                border
                border-white/[0.09]
                bg-white/[0.025]
                px-4
                text-sm
                font-semibold
                text-muted
                transition
              "
              data-program-filter="{{ .id }}"
              data-accent="{{ .accent }}"
              aria-pressed="{{ if eq .id "kajian-pendidikan" }}true{{ else }}false{{ end }}"
            >
              {{ .name }}

              <span
                class="
                  program-category-count
                  flex
                  min-w-5
                  items-center
                  justify-center
                  rounded-full
                  bg-white/[0.06]
                  px-1.5
                  py-0.5
                  text-[0.6875rem]
                  font-bold
                  {{ .accent }}
                "
              >
                {{ len $categoryPages }}
              </span>
            </button>

          {{ end }}

        {{ end }}

      </nav>


      <!-- PROGRAM GROUPS -->

      <div class="space-y-20 lg:space-y-24">

        {{ range $categories }}

          {{ $category := . }}
          {{ $categoryPages := where $pages "Params.category" $category.name }}

          {{ if gt (len $categoryPages) 0 }}

            <section
              id="{{ $category.id }}"
              class="program-category-panel{{ if ne $category.id "kajian-pendidikan" }} hidden{{ end }}"
              data-program-category="{{ $category.id }}"
            >

              <!-- CATEGORY HEADER -->

              <div
                class="
                  mb-7
                  grid
                  gap-4
                  border-b
                  border-white/[0.08]
                  pb-6
                  sm:grid-cols-[1fr_auto]
                  sm:items-end
                "
              >

                <div>

                  <div class="flex items-center gap-3">

                    <span
                      class="
                        h-px
                        w-8
                        {{ $category.line }}
                      "
                      aria-hidden="true"
                    ></span>

                    <p
                      class="
                        text-xs
                        font-bold
                        uppercase
                        tracking-[0.15em]
                        {{ $category.accent }}
                      "
                    >
                      Kategori Program
                    </p>

                  </div>

                  <h2
                    class="
                      mt-3
                      text-2xl
                      font-bold
                      tracking-[-0.03em]
                      sm:text-3xl
                    "
                  >
                    {{ $category.name }}
                  </h2>

                  <p
                    class="
                      mt-2
                      max-w-2xl
                      text-sm
                      leading-[1.6]
                      text-muted
                    "
                  >
                    {{ $category.description }}
                  </p>

                </div>

                <p
                  class="
                    text-xs
                    font-semibold
                    text-muted
                    sm:pb-1
                  "
                >
                  {{ len $categoryPages }} program
                </p>

              </div>


              <!-- CATEGORY CARDS -->

              <div class="space-y-3">

                {{ range $page := $categoryPages }}

                  {{ $globalIndex := 0 }}

                  {{ range $i, $candidate := $pages }}
                    {{ if eq $candidate.RelPermalink $page.RelPermalink }}
                      {{ $globalIndex = add $i 1 }}
                    {{ end }}
                  {{ end }}


                  <article
                    class="
                      group
                      relative
                      overflow-hidden
                      rounded-[28px]
                      border border-white/[0.08]
                      bg-card
                      transition
                      duration-300
                      {{ $category.border }}
                    "
                  >

                    <a
                      href="{{ $page.RelPermalink }}"
                      class="
                        grid
                        lg:grid-cols-[0.8fr_1.2fr]
                      "
                    >


                      <!-- IMAGE -->

                      <div
                        class="
                          relative
                          min-h-[220px]
                          overflow-hidden
                          lg:min-h-[250px]
                        "
                      >

                        {{ with $page.Params.thumbnail }}

                          <img
                            src="{{ . }}"
                            srcset="
                              {{ replace . "-1280.webp" "-640.webp" }} 640w,
                              {{ replace . "-1280.webp" "-960.webp" }} 960w,
                              {{ . }} 1280w
                            "
                            sizes="
                              (min-width: 1024px) 48vw,
                              100vw
                            "
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="
                              absolute
                              inset-0
                              h-full
                              w-full
                              object-cover
                              transition
                              duration-700
                              ease-out
                              group-hover:scale-[1.025]
                            "
                          >

                          <div
                            class="
                              absolute
                              inset-0
                              bg-gradient-to-t
                              from-black/50
                              via-black/5
                              to-transparent
                              lg:bg-gradient-to-r
                              lg:from-transparent
                              lg:via-transparent
                              lg:to-card/70
                            "
                            aria-hidden="true"
                          ></div>

                        {{ else }}

                          <div
                            class="
                              absolute
                              inset-0
                              bg-[radial-gradient(circle_at_20%_15%,rgb(102_201_255/0.20),transparent_32%),radial-gradient(circle_at_75%_75%,rgb(162_138_229/0.16),transparent_34%),linear-gradient(135deg,#162331,#111620)]
                            "
                            aria-hidden="true"
                          ></div>

                        {{ end }}


                        <!-- GLOBAL NUMBER -->

                        <div
                          class="
                            absolute
                            left-5
                            top-5
                            flex
                            size-9
                            items-center
                            justify-center
                            rounded-full
                            border border-white/15
                            bg-black/25
                            text-xs
                            font-bold
                            tracking-[0.08em]
                            text-white
                            backdrop-blur-md
                          "
                        >
                          {{ printf "%02d" $globalIndex }}
                        </div>

                      </div>


                      <!-- CONTENT -->

                      <div
                        class="
                          relative
                          flex
                          flex-col
                          justify-between
                          p-6
                          sm:p-7
                          lg:p-8
                        "
                      >

                        <div>

                          <div class="flex items-center gap-3">

                            <span
                              class="
                                h-px
                                w-6
                                {{ $category.line }}
                              "
                              aria-hidden="true"
                            ></span>

                            <p
                              class="
                                text-xs
                                font-bold
                                uppercase
                                tracking-[0.14em]
                                {{ $category.accent }}
                              "
                            >
                              {{ $page.Params.category }}
                            </p>

                          </div>


                          <h3
                            class="
                              mt-4
                              max-w-xl
                              text-2xl
                              font-bold
                              leading-[1.12]
                              tracking-[-0.03em]
                              sm:text-3xl
                            "
                          >
                            {{ $page.Title }}
                          </h3>


                          {{ with $page.Params.summary }}

                            <p
                              class="
                                mt-3
                                max-w-lg
                                text-sm
                                leading-[1.6]
                                text-muted
                              "
                            >
                              {{ . }}
                            </p>

                          {{ end }}

                        </div>


                        <div
                          class="
                            mt-6
                            flex
                            items-center
                            justify-between
                            gap-5
                          "
                        >

                          <span
                            class="
                              text-sm
                              font-semibold
                              tracking-[-0.01em]
                              {{ $category.accent }}
                            "
                          >
                            Lihat Program
                          </span>


                          <span
                            class="
                              flex
                              size-9
                              items-center
                              justify-center
                              rounded-full
                              border border-white/15
                              bg-white/[0.025]
                              text-lg
                              text-muted
                              transition
                              duration-300
                              group-hover:translate-x-1
                              group-hover:border-white/30
                              group-hover:bg-white/[0.05]
                              group-hover:text-white
                            "
                            aria-hidden="true"
                          >
                            →
                          </span>

                        </div>

                      </div>

                    </a>

                  </article>

                {{ end }}

              </div>

            </section>

          {{ end }}

        {{ end }}

      </div>

    </div>

  </div>

</section>

<script>
  (() => {
    const filters = document.querySelectorAll(
      "[data-program-filter]"
    );

    const panels = document.querySelectorAll(
      "[data-program-category]"
    );

    if (!filters.length || !panels.length) return;

    const defaultCategory = "kajian-pendidikan";

    const validCategories = new Set(
      [...filters].map((button) => button.dataset.programFilter)
    );

    function setCategory(category, updateHash = true) {
      if (!validCategories.has(category)) {
        category = defaultCategory;
      }

      filters.forEach((button) => {
        const active =
          button.dataset.programFilter === category;

        button.setAttribute(
          "aria-pressed",
          String(active)
        );

        button.classList.toggle(
          "is-active",
          active
        );
      });

      panels.forEach((panel) => {
        const active =
          panel.dataset.programCategory === category;

        panel.classList.toggle(
          "hidden",
          !active
        );
      });

      if (updateHash) {
        history.replaceState(
          null,
          "",
          `#${category}`
        );
      }
    }

    filters.forEach((button) => {
      button.addEventListener("click", () => {
        setCategory(
          button.dataset.programFilter
        );
      });
    });

    const hash =
      window.location.hash.replace("#", "");

    setCategory(
      validCategories.has(hash)
        ? hash
        : defaultCategory,
      false
    );
  })();
</script>

{{ end }}
