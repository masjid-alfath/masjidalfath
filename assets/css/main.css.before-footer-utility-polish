@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@theme {

  /* Typography */
  --font-sans: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;

  /* Midnight Aurora */
  --color-midnight: #080B13;
  --color-surface: #0D111B;
  --color-card: #111620;

  --color-foreground: #F5F6F8;
  --color-muted: #A7ADB8;

  /* Primary */
  --color-indigo: #3436A8;
  --color-indigo-hover: #4144C2;

  /* Ambient accents */
  --color-aurora-cyan: #66C9FF;
  --color-aurora-violet: #A28AE5;
  --color-aurora-coral: #FF7064;

  /* Minor Third — 1.2 */
  --text-xs: 0.6875rem;
  --text-sm: 0.8125rem;
  --text-base: 1rem;
  --text-lg: 1.1875rem;
  --text-xl: 1.4375rem;
  --text-2xl: 1.75rem;
  --text-3xl: 2.0625rem;
  --text-4xl: 2.5rem;
  --text-5xl: 3rem;
  --text-6xl: 3.625rem;
}


/* ========================================
   BASE
========================================= */

@layer base {
  html {
    font-family: var(--font-sans);
    scroll-behavior: smooth;
  }

  body {
    @apply bg-midnight text-foreground antialiased;
  }

  a,
  button {
    @apply focus:outline-none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #66C9FF;
    outline-offset: 4px;
  }
}


/* ========================================
   COMPONENTS
========================================= */

@layer components {

  .container-site {
    @apply mx-auto w-full max-w-[1120px] px-4 md:px-6;
  }


  /* Buttons */

  .btn-primary {
    @apply inline-flex items-center justify-center rounded-xl
           bg-indigo px-5 py-3 font-semibold text-white
           transition duration-200
           hover:bg-indigo-hover;
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center rounded-xl
           border border-white/15 px-5 py-3 font-semibold
           transition duration-200
           hover:bg-white/5;
  }


  /* Cards */

  .surface-card {
    @apply rounded-2xl border border-white/[0.075] bg-card;
  }


  /* Typography */

  .eyebrow {
    @apply text-sm font-bold uppercase tracking-[0.16em];
  }


  /* ========================================
     MIDNIGHT AURORA
  ========================================= */

  .aurora-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .aurora-hero::before {
    content: "";
    position: absolute;
    z-index: -2;
    inset: 0;

    background:
      radial-gradient(
        circle at 8% 0%,
        rgb(102 201 255 / 0.22),
        transparent 30%
      ),
      radial-gradient(
        circle at 92% 0%,
        rgb(255 112 100 / 0.22),
        transparent 32%
      ),
      radial-gradient(
        circle at 52% 8%,
        rgb(162 138 229 / 0.16),
        transparent 30%
      );
  }

  .aurora-hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;

    background:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(8 11 19 / 0.3) 55%,
        #080B13 100%
      );
  }


  /* Gradient Text */

  .aurora-text {
    background:
      linear-gradient(
        90deg,
        #66C9FF 0%,
        #A28AE5 50%,
        #FF7064 100%
      );

    background-clip: text;
    -webkit-background-clip: text;

    color: transparent;
  }

}

/* ========================================
   LIGHT MODE
========================================= */

html:not(.dark) {
  color-scheme: light;
}

html.dark {
  color-scheme: dark;
}

html:not(.dark) body {
  background: #F7F8FA;
  color: #111827;
}

html:not(.dark) .bg-midnight {
  background-color: #F7F8FA;
}

html:not(.dark) .bg-surface {
  background-color: #FFFFFF;
}

html:not(.dark) .bg-card {
  background-color: #FFFFFF;
}

html:not(.dark) .text-foreground {
  color: #111827;
}

html:not(.dark) .text-muted {
  color: #667085;
}

html:not(.dark) .nav-link:hover {
  color: #111827;
}

html:not(.dark) .btn-secondary {
  border-color: rgb(17 24 39 / 0.12);
  color: #111827;
}

html:not(.dark) .btn-secondary:hover {
  background-color: rgb(17 24 39 / 0.04);
}

html:not(.dark) .surface-card {
  border-color: rgb(17 24 39 / 0.08);
  background-color: #FFFFFF;
}

html:not(.dark) header {
  border-color: rgb(17 24 39 / 0.08);
  background-color: rgb(247 248 250 / 0.88);
}

html:not(.dark) footer {
  border-color: rgb(17 24 39 / 0.08);
}

html:not(.dark) .aurora-hero::before {
  background:
    radial-gradient(
      circle at 8% 0%,
      rgb(102 201 255 / 0.18),
      transparent 30%
    ),
    radial-gradient(
      circle at 92% 0%,
      rgb(255 112 100 / 0.14),
      transparent 32%
    ),
    radial-gradient(
      circle at 52% 8%,
      rgb(162 138 229 / 0.12),
      transparent 30%
    );
}

html:not(.dark) .aurora-hero::after {
  background:
    linear-gradient(
      to bottom,
      transparent 0%,
      rgb(247 248 250 / 0.15) 55%,
      #F7F8FA 100%
    );
}

/*
  Existing templates still use white-based border utilities.
  Normalize them in light mode without rewriting every section.
*/

html:not(.dark) [class*="border-white"] {
  border-color: rgb(17 24 39 / 0.09);
}

/*
  White hover backgrounds used by navigation/cards become
  subtle dark overlays on light surfaces.
*/

html:not(.dark) [class*="hover:bg-white"]:hover {
  background-color: rgb(17 24 39 / 0.045);
}

/*
  Preserve intentionally white content inside strong indigo
  ZISWAF surfaces.
*/

html:not(.dark) .bg-indigo .text-white,
html:not(.dark) [class*="bg-indigo"] .text-white {
  color: #FFFFFF;
}

/*
  Light-mode accent colors need slightly more contrast.
*/

html:not(.dark) .text-aurora-cyan {
  color: #168FC7;
}

html:not(.dark) .text-aurora-violet {
  color: #7259C8;
}

html:not(.dark) .text-aurora-coral {
  color: #D9534F;
}


/* =========================================================
   ARTICLE TYPOGRAPHY
   ========================================================= */

@layer components {

  .article-content {
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1.85;
  }


  /* ---------- Paragraph ---------- */

  .article-content p {
    margin-top: 1.4rem;
    color: var(--color-muted);
  }

  .article-content > p:first-child {
    margin-top: 0;
  }


  /* ---------- Headings ---------- */

  .article-content h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;

    color: var(--color-foreground);

    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .article-content h3 {
    margin-top: 2.5rem;
    margin-bottom: 0.8rem;

    color: var(--color-foreground);

    font-size: 1.4375rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .article-content h4 {
    margin-top: 2rem;
    margin-bottom: 0.7rem;

    color: var(--color-foreground);

    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.4;
  }


  /* ---------- Mobile overflow safety ---------- */

  .article-content {
    min-width: 0;
    max-width: 100%;
  }

  .article-content p,
  .article-content li,
  .article-content blockquote,
  .article-content figure {
    min-width: 0;
    max-width: 100%;
  }


  /* ---------- Strong / emphasis ---------- */

  .article-content strong {
    color: var(--color-foreground);
    font-weight: 700;
  }

  .article-content em {
    font-style: italic;
  }


  /* ---------- Links ---------- */

  .article-content a {
    color: var(--color-aurora-cyan);
    font-weight: 600;

    overflow-wrap: anywhere;
    word-break: break-word;

    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;

    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  .article-content a:hover {
    color: #ffffff;
  }


  /* ---------- Lists ---------- */

  .article-content ul,
  .article-content ol {
    margin-top: 1.4rem;
    padding-left: 1.5rem;

    color: var(--color-muted);
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    margin-top: 0.55rem;
    padding-left: 0.3rem;
  }

  .article-content li::marker {
    color: var(--color-aurora-cyan);
  }


  /* ---------- Blockquote ---------- */

  .article-content blockquote {
    position: relative;

    margin-top: 2rem;
    margin-bottom: 2rem;

    padding: 1.4rem 1.5rem;

    border-left: 3px solid var(--color-aurora-violet);
    border-radius: 0 1rem 1rem 0;

    background:
      linear-gradient(
        90deg,
        rgb(162 138 229 / 0.09),
        rgb(162 138 229 / 0.025)
      );
  }

  .article-content blockquote p {
    margin: 0;

    color: var(--color-foreground);

    font-size: 1.05rem;
    line-height: 1.8;
  }


  /* ---------- Horizontal rule ---------- */

  .article-content hr {
    margin-top: 3rem;
    margin-bottom: 3rem;

    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.09);
  }


  /* ---------- Images ---------- */

  .article-content img {
    width: 100%;
    height: auto;

    margin-top: 2.5rem;
    margin-bottom: 2.5rem;

    border-radius: 1.25rem;
  }


  /* ---------- Figure ---------- */

  .article-content figure {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .article-content figure img {
    margin: 0;
  }

  .article-content figcaption {
    margin-top: 0.8rem;

    color: var(--color-muted);

    font-size: 0.8125rem;
    line-height: 1.6;
    text-align: center;
  }


  /* ---------- Inline code ---------- */

  .article-content code {
    padding: 0.15rem 0.4rem;

    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.4rem;

    background: var(--color-card);

    color: var(--color-aurora-cyan);

    font-size: 0.9em;
  }


  /* ---------- Code block ---------- */

  .article-content pre {
    overflow-x: auto;

    margin-top: 2rem;
    margin-bottom: 2rem;

    padding: 1.25rem;

    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1rem;

    background: var(--color-card);

    font-size: 0.875rem;
    line-height: 1.7;
  }

  .article-content pre code {
    padding: 0;

    border: 0;
    background: transparent;

    color: inherit;
  }


  /* =========================================================
     ARABIC / QURAN
     ========================================================= */

  .article-content .arabic,
  .article-content [lang="ar"] {
    direction: rtl;

    margin-top: 2rem;
    margin-bottom: 2rem;

    color: var(--color-foreground);

    font-family:
      "AlFath Arabic",
      "Noto Naskh Arabic",
      serif;

    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 400;
    line-height: 2;

    text-align: right;
  }


  /* =========================================================
     LIGHT MODE
     ========================================================= */

  html:not(.dark) .article-content {
    color: #111827;
  }

  html:not(.dark) .article-content p,
  html:not(.dark) .article-content ul,
  html:not(.dark) .article-content ol,
  html:not(.dark) .article-content figcaption {
    color: #667085;
  }

  html:not(.dark) .article-content h2,
  html:not(.dark) .article-content h3,
  html:not(.dark) .article-content h4,
  html:not(.dark) .article-content strong,
  html:not(.dark) .article-content blockquote p,
  html:not(.dark) .article-content .arabic,
  html:not(.dark) .article-content [lang="ar"] {
    color: #111827;
  }

  html:not(.dark) .article-content a {
    color: #168fc7;
  }

  html:not(.dark) .article-content a:hover {
    color: #3436a8;
  }

  html:not(.dark) .article-content blockquote {
    background:
      linear-gradient(
        90deg,
        rgb(114 89 200 / 0.08),
        rgb(114 89 200 / 0.02)
      );
  }

  html:not(.dark) .article-content hr {
    border-color: rgb(17 24 39 / 0.09);
  }

  html:not(.dark) .article-content code,
  html:not(.dark) .article-content pre {
    border-color: rgb(17 24 39 / 0.08);
    background: #f2f4f7;
  }


  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (min-width: 768px) {

    .article-content {
      font-size: 1.0625rem;
    }

  }

}



/* =========================================================
   LOCAL ARABIC FONT
   ========================================================= */

@font-face {
  font-family: "AlFath Arabic";
  src: url("/font/arabic-font.woff2") format("woff2");
  font-style: normal;
  font-weight: 400;
  font-display: swap;
}



/* ==========================================================
   ACCESSIBILITY
   ========================================================== */

/*
  Keyboard focus
  Hanya tampil ketika navigasi menggunakan keyboard,
  sehingga tidak mengganggu tampilan saat klik mouse/touch.
*/

@layer base {

  :where(
    a,
    button,
    input,
    select,
    textarea,
    summary,
    [tabindex]:not([tabindex="-1"])
  ):focus-visible {
    outline: 2px solid var(--color-aurora-cyan);
    outline-offset: 3px;
  }

}


/*
  Respect operating-system reduced motion preference.
*/

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

}


/* ==========================================================
   GLOBAL POLISH V1
   Navigation / interaction / brand consistency
   ========================================================== */

@layer components {

  /* ----------------------------------------------------------
     Desktop navigation
     ---------------------------------------------------------- */

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-block: 0.45rem;
    color: var(--color-muted);
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--color-aurora-cyan),
      var(--color-aurora-violet)
    );
    opacity: 0;
    transform: translateX(-50%);
    transition:
      width 180ms ease,
      opacity 180ms ease;
  }

  .nav-link:hover {
    color: var(--color-foreground);
  }

  /* Underline is reserved for the active page */
  .nav-link:hover::after {
    width: 0;
    opacity: 0;
  }

  .nav-link.is-active {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .nav-link.is-active::after,
  .nav-link.is-active:hover::after {
    width: 100%;
    opacity: 1;
  }


  /* ----------------------------------------------------------
     ZISWAF navbar CTA
     ---------------------------------------------------------- */

  .nav-ziswaf {
    position: relative;
  }

  .nav-ziswaf.is-active {
    background-color: var(--color-indigo-hover);
    box-shadow:
      0 0 0 1px rgb(102 201 255 / 0.16),
      0 8px 28px rgb(52 54 168 / 0.22);
  }


  /* ----------------------------------------------------------
     Mobile navigation
     ---------------------------------------------------------- */

  .mobile-nav-link {
    position: relative;
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.75rem;
    padding: 0.625rem 0.75rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .mobile-nav-link:hover {
    background: rgb(255 255 255 / 0.05);
    color: var(--color-foreground);
  }

  .mobile-nav-link.is-active {
    background:
      linear-gradient(
        90deg,
        rgb(102 201 255 / 0.08),
        rgb(162 138 229 / 0.06)
      );
    color: var(--color-foreground);
    font-weight: 600;
  }

  .mobile-nav-link.is-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 2px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-aurora-cyan);
    transform: translateY(-50%);
  }

  .mobile-nav-dot {
    width: 5px;
    height: 5px;
    flex: none;
    border-radius: 999px;
    background: var(--color-aurora-cyan);
    box-shadow: 0 0 12px rgb(102 201 255 / 0.5);
  }

  .mobile-ziswaf {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    border-radius: 0.75rem;
    background: var(--color-indigo);
    padding: 0.75rem 1rem;
    color: white;
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .mobile-ziswaf:hover {
    background: var(--color-indigo-hover);
  }

  .mobile-ziswaf.is-active {
    background: var(--color-indigo-hover);
    box-shadow:
      0 0 0 1px rgb(102 201 255 / 0.18),
      0 8px 28px rgb(52 54 168 / 0.2);
  }


  /* ----------------------------------------------------------
     Global interactive refinement
     ---------------------------------------------------------- */

  .btn-primary {
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .btn-primary:hover {
    box-shadow: 0 8px 24px rgb(52 54 168 / 0.22);
  }

  .btn-primary:active,
  .mobile-ziswaf:active {
    transform: translateY(1px);
  }

  .btn-secondary {
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .btn-secondary:hover {
    border-color: rgb(255 255 255 / 0.22);
  }

  .btn-secondary:active {
    transform: translateY(1px);
  }
}


/* ------------------------------------------------------------
   Light-mode interaction normalization
   ------------------------------------------------------------ */

html:not(.dark) .btn-secondary:hover {
  border-color: rgb(17 24 39 / 0.18);
}


/* ------------------------------------------------------------
   Pointer-only hover lift
   Avoid unnecessary movement on touch devices
   ------------------------------------------------------------ */

@media (hover: hover) and (pointer: fine) {
  .btn-primary:hover,
  .mobile-ziswaf:hover {
    transform: translateY(-1px);
  }
}


/* Light navbar readability */
html:not(.dark) .nav-link {
  color: #667085;
}

html:not(.dark) .nav-link:hover {
  color: #1f2937;
}

html:not(.dark) .nav-link.is-active {
  color: #111827;
}

/* Navbar typography refinement */
@media (min-width: 768px) {
  .nav-link {
    font-size: 0.9375rem; /* 15px */
    font-weight: 500;
  }

  .nav-link.is-active {
    font-weight: 600;
  }

  .nav-ziswaf {
    font-size: 0.9375rem; /* 15px */
  }
}

/* ==========================================================
   FOOTER TYPOGRAPHY POLISH
   Balanced with desktop navigation + Minor Third hierarchy
   ========================================================== */

@layer components {

  /* Section titles: Jelajahi / ZISWAF / Lokasi */
  footer h2,
  footer h3 {
    font-size: 0.9375rem; /* 15px */
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* Footer navigation */
  footer nav a {
    font-size: 0.9375rem; /* 15px */
    line-height: 1.5;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  footer nav a:hover {
    color: var(--color-foreground);
  }

  /* Supporting copy: brand description + address */
  footer p {
    font-size: 0.875rem; /* 14px */
    line-height: 1.7;
  }

  /* Legal / bottom bar remains intentionally secondary */
  footer .footer-meta {
    font-size: 0.75rem; /* 12px */
    line-height: 1.5;
  }
}


/* Light footer readability */
html:not(.dark) footer nav a,
html:not(.dark) footer p {
  color: #667085;
}

html:not(.dark) footer nav a:hover {
  color: #111827;
}


/* Mobile: larger type, tighter rhythm */
/* ==========================================================
   GLOBAL LINK INTERACTION
   Underline is reserved for active navigation only
   ========================================================== */

/* Footer links: no decorative underline */
footer a:not(.btn-primary):not(.btn-secondary) {
  text-decoration: none;
}

footer a:not(.btn-primary):not(.btn-secondary):hover {
  text-decoration: none;
  color: var(--color-foreground);
}

/* Light mode */
html:not(.dark) footer a:not(.btn-primary):not(.btn-secondary):hover {
  color: #111827;
}

/* ==========================================================
   TYPOGRAPHY SYSTEM
   Masjid Al-Fath — Midnight Aurora
   ========================================================== */

@layer base {
  body {
    line-height: 1.45;
  }

  h1,
  h2,
  h3 {
    line-height: 1.08;
  }

  h4,
  h5,
  h6 {
    line-height: 1.18;
  }

  p {
    line-height: 1.48;
  }
}


/* ==========================================================
   CONTENT CTA
   Notion [CTA] → Hugo
   Visual mengikuti btn-primary
   ========================================================== */

.article-content .content-cta {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;

  margin-top: 0.35rem;
  margin-bottom: 0.75rem;

  padding: 0.75rem 1.1rem;

  color: #fff;
  font-size: var(--text-sm);
  font-weight: 600;
  line-height: 1.2;

  text-decoration: none;
}

.article-content .content-cta:hover {
  color: #fff;
  text-decoration: none;
}

.article-content .content-cta span {
  color: inherit;
  line-height: inherit;
}


/* ==========================================================
   CONTENT COPY
   Notion [COPY:value] → clipboard button
   ========================================================== */

.article-content .content-copy {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;

  margin-top: 0.35rem;
  margin-bottom: 0.75rem;

  padding: 0.75rem 1.1rem;

  color: #fff;
  font-size: var(--text-sm);
  font-weight: 600;
  line-height: 1.2;

  cursor: pointer;
}

.article-content .content-copy-success {
  display: none;
}

.article-content .content-copy-success:not(.hidden) {
  display: inline;
}

.article-content .content-copy.is-copied {
  box-shadow:
    0 0 0 1px rgb(102 201 255 / 0.20),
    0 8px 28px rgb(52 54 168 / 0.22);
}


/* ==========================================================
   LONG-FORM EDITORIAL
   ========================================================== */

.article-content {
  line-height: 1.6;
}

.article-content p {
  margin-top: 0;
  margin-bottom: 1.15em;
  line-height: 1.6;
}

.article-content li {
  line-height: 1.55;
}

.article-content h2 {
  line-height: 1.15;
}

.article-content h3 {
  line-height: 1.18;
}


/* ==========================================================
   FOOTER TYPOGRAPHY
   Navigation spacing lives in footer.html, not here.
   ========================================================== */

footer p,
footer address {
  line-height: 1.45;
}

footer nav a {
  min-height: 0;
  padding-block: 0;
  line-height: 1.4;
}



/* ==========================================================
   MOBILE NAVIGATION — LIGHT MODE
   Clear hierarchy without changing dark mode
   ========================================================== */

@media (max-width: 767px) {

  /* Header / expanded menu surface */
  html:not(.dark) header {
    background-color: rgb(255 255 255 / 0.96);
    border-color: rgb(17 24 39 / 0.10);
  }

  /* Hamburger / close button */
  html:not(.dark) #mobile-menu-button {
    color: #1F2937;
    border-color: rgb(17 24 39 / 0.12);
    background-color: #F8FAFC;
  }

  html:not(.dark) #mobile-menu-button:hover {
    color: #111827;
    background-color: #F1F5F9;
    border-color: rgb(17 24 39 / 0.16);
  }

  /* Divider under navbar */
  html:not(.dark) #mobile-menu {
    border-color: rgb(17 24 39 / 0.08);
  }

  /* Navigation text needs more authority than global muted */
  html:not(.dark) .mobile-nav-link {
    color: #475467;
  }

  html:not(.dark) .mobile-nav-link:hover {
    color: #111827;
    background-color: #F8FAFC;
  }

  html:not(.dark) .mobile-nav-link.is-active {
    color: #111827;
    background:
      linear-gradient(
        90deg,
        rgb(22 143 199 / 0.09),
        rgb(114 89 200 / 0.055)
      );
  }

  /* Appearance row */
  html:not(.dark) #mobile-menu .theme-toggle {
    color: #475467;
    border-color: rgb(17 24 39 / 0.10);
    background-color: #F8FAFC;
  }

  html:not(.dark) #mobile-menu .theme-toggle:hover {
    color: #111827;
    border-color: rgb(17 24 39 / 0.14);
    background-color: #F1F5F9;
  }

  html:not(.dark) #mobile-menu .theme-label {
    color: #475467;
  }
}

