{
  "name": "masjid-alfath",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/main.css --watch",
    "dev:hugo": "hugo server --disableFastRender",
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:hugo\"",
    "sync:notion": "node scripts/sync-notion.js",
    "sync": "npm run sync:notion",
    "build:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/main.css --minify",
    "build:hugo": "hugo --cleanDestinationDir --minify",
    "build": "npm run sync && npm run build:css && npm run build:hugo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "dotenv": "^18.0.3",
    "sharp": "^0.35.4"
  }
}
