  "main": "index.js",
  "scripts": {
  "dev:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/main.css --watch",
  "dev:hugo": "hugo server --disableFastRender",
  "dev": "concurrently \"npm:dev:css\" \"npm:dev:hugo\"",
  "build:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/main.css --minify",
  "build:hugo": "hugo --minify",
  "build": "npm run build:css && npm run build:hugo"
},
